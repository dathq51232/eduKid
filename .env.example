# Sao chép thành .env.local (máy dev) hoặc khai báo trong biến môi trường của nơi triển khai.
# KHÔNG commit giá trị thật. Xem docs/AUTH-SETUP.md.

# Công khai (trình duyệt dùng được)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# CHỈ MÁY CHỦ — tuyệt đối không đặt tên NEXT_PUBLIC_*
# Dùng để tạo tài khoản học sinh, đặt PIN, ghi kết quả đã chấm lại.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Chuỗi bí mật ngẫu nhiên >= 32 ký tự để tạo mật khẩu đăng nhập từ PIN học sinh.
# Đổi chuỗi này = mọi PIN cũ hết hiệu lực (giáo viên phải đặt PIN mới).
STUDENT_PIN_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET

# "Kết quả học tập trên trường" + "Nhận xét học sinh" mặc định BẬT — đặt "off" để tắt
# NEXT_PUBLIC_FEATURE_SO_THEO_DOI=off
# Thu phí học sinh (migration 0018) đang ẩn — đặt "on" để hiện lại mục Thu phí trong quản trị
# NEXT_PUBLIC_FEATURE_THU_PHI=on
# Trợ lý AI (migration 0030) mặc định BẬT — đặt "off" để ẩn nút Trợ lý AI khỏi khung giáo viên
# NEXT_PUBLIC_FEATURE_TRO_LY_AI=off

# CHỈ MÁY CHỦ — mã hoá API key AI của giáo viên (AES-256-GCM) trước khi lưu database.
# Chuỗi bí mật ngẫu nhiên >= 32 ký tự. Đổi chuỗi này = các key đã lưu hết hiệu lực (thầy cô phải dán lại).
# Xem docs/tro-ly-ai.md.
AI_KEY_ENCRYPTION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
